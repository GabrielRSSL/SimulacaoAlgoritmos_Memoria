.venv/
__pycache__/
.pytest_cache/
*.pyc
.mplconfig/
.pytest_tmp/

# Intermediários de preparação/conferência e arquivos finais entregues pelo chat.
/tmp/
/output/
# Preferência do autor: incluir automaticamente novas pastas com essa mesma
# finalidade no ignore, preservando os arquivos locais. Não aplicar essa regra
# aos resultados científicos e materiais necessários à reprodução.

# Materiais pessoais da redação do artigo e biblioteca local de leitura.
# O protocolo público está em docs/protocolo_v1.md.
/Referencias/
~$*.docx
.~lock.*#

# Pedido e recibos da entrega ao autor; não são documentação de uso público.
/docs/solicitacao_original.txt
/ENTREGA.md
/manifesto_entrega.json

# Saídas auxiliares duplicadas da verificação dos comandos.
# Preservar piloto, coleta principal e congelamentos para reprodução.
/resultados/rastros_avulsos_*/
/resultados/execucao_avulsa_*/
/resultados/analise_regenerada_*/
